[
  {
    "name": "Password",
    "pattern": "(?i)(?<![\\w:/-])(?:(?:[a-z0-9]+[_-])*(?:password|passwd|pwd|passphrase))[\"']?[ \\t]*[:=][ \\t]*(?P<secret>`[^`\\r\\n]+`|\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\"'`#;,}\\]]+)",
    "severity": "HIGH",
    "generic": true,
    "assignment": true,
    "allow_weak": true
  },
  {
    "name": "Access or Session Token",
    "pattern": "(?i)(?<![\\w:/-])(?:(?:[a-z0-9]+[_-])*(?:access[_-]?token|refresh[_-]?token|auth[_-]?token|session[_-]?(?:token|secret|id)|bearer[_-]?token|token))[\"']?[ \\t]*[:=][ \\t]*(?P<secret>`[^`\\r\\n]+`|\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\"'`#;,}\\]]+)",
    "severity": "HIGH",
    "generic": true,
    "assignment": true,
    "allow_weak": false,
    "min_length": 12
  },
  {
    "name": "Client or Signing Secret",
    "pattern": "(?i)(?<![\\w:/-])(?:(?:[a-z0-9]+[_-])*(?:client[_-]?secret|secret[_-]?key|signing[_-]?key|encryption[_-]?key|private[_-]?key|secret))[\"']?[ \\t]*[:=][ \\t]*(?P<secret>`[^`\\r\\n]+`|\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\"'`#;,}\\]]+)",
    "severity": "HIGH",
    "generic": true,
    "assignment": true,
    "allow_weak": false,
    "min_length": 12
  },
  {
    "name": "Cloud Secret Credential",
    "pattern": "(?i)(?<![\\w:/-])(?:(?:aws[_-]secret[_-]access[_-]key|aws[_-]session[_-]token|azure[_-]client[_-]secret|account[_-]key))[\"']?[ \\t]*[:=][ \\t]*(?P<secret>`[^`\\r\\n]+`|\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\"'`#;,}\\]]+)",
    "severity": "HIGH",
    "generic": true,
    "assignment": true,
    "allow_weak": false,
    "min_length": 12
  },
  {
    "name": "Login Identifier",
    "pattern": "(?i)(?<![\\w:/-])(?:(?:user|email|client_email|username|user[_-]name|db[_-]user|db[_-]username|login[_-]user|login[_-]email|auth[_-]email))[\"']?[ \\t]*[:=][ \\t]*(?P<secret>`[^`\\r\\n]+`|\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\"'`#;,}\\]]+)",
    "severity": "INFO",
    "generic": true,
    "assignment": true,
    "allow_weak": false,
    "remediation": "Review this account identifier alongside nearby password or token findings. An identifier alone does not prove credential exposure."
  },
  {
    "name": "HTTP Authorization",
    "pattern": "(?i)\\b(?:authorization|proxy-authorization)[\"']?\\s*[:=]\\s*[\"']?(?P<secret>(?:Bearer|Basic)\\s+[A-Za-z0-9._~+/=-]{6,})",
    "severity": "HIGH",
    "generic": true
  },
  {
    "name": "Credential URI",
    "pattern": "\\b[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s\"'<>]+",
    "severity": "HIGH",
    "credential_uri": true,
    "generic": true
  },
  {
    "name": "XML Password",
    "pattern": "(?i)<(?:password|passwd|pwd|passphrase)>\\s*(?P<secret>[^<\\r\\n]+)\\s*</(?:password|passwd|pwd|passphrase)>",
    "severity": "HIGH",
    "allow_weak": true
  },
  {
    "name": "API Credential",
    "pattern": "(?i)(?<![\\w:/-])(?:(?:[a-z0-9]+[_-])*(?:api[_-]?key|api[_-]?secret))[\"']?[ \\t]*[:=][ \\t]*(?P<secret>`[^`\\r\\n]+`|\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[^\\s\"'`#;,}\\]]+)",
    "severity": "MEDIUM",
    "generic": true,
    "assignment": true,
    "allow_weak": false,
    "min_length": 12
  },
  {
    "name": "Bcrypt Password Hash",
    "pattern": "\\$2[aby]\\$\\d{2}\\$[./A-Za-z0-9]{53}",
    "severity": "HIGH",
    "remediation": "Remove the password hash from exposed files and review the affected account for password reset. A hash is not a plaintext password, but may enable offline guessing."
  },
  {
    "name": "Argon2 Password Hash",
    "pattern": "\\$argon2(?:id|i|d)\\$v=\\d+\\$m=\\d+,t=\\d+,p=\\d+\\$[A-Za-z0-9+/=]+\\$[A-Za-z0-9+/=]+",
    "severity": "HIGH",
    "remediation": "Remove the exposed password hash and review whether the affected account needs a password reset."
  }
]
